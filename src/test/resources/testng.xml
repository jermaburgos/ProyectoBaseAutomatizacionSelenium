<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite">

    <listeners>
        <listener class-name="report.TestListener"/>
    </listeners>

    <test name="Regression">
        <groups>
            <run>
                <exclude name="critical"/>
            </run>
        </groups>
        <packages>
            <package name="test"/>
        </packages>
    </test>

    <test name="Critical">
        <groups>
            <run>
                <include name="critical"/>
            </run>
        </groups>
        <packages>
            <package name="test"/>
        </packages>
    </test>

</suite>
